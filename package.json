{
    "name": "chatai-plugin",
    "version": "1.0.0",
    "type": "module",
    "description": "Yunzai AI 聊天插件",
    "license": "MIT",
    "main": "index.js",
    "engines": {
        "node": ">=20.18.1"
    },
    "scripts": {
        "format": "prettier --write \"**/*.{js,ts,tsx}\" --ignore-path .prettierignore",
        "format:check": "prettier --check \"**/*.{js,ts,tsx}\" --ignore-path .prettierignore",
        "lint": "eslint ./apps --cache --concurrency=auto --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,ts,tsx}": "prettier --write --ignore-path .prettierignore"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.125.0",
        "@google/generative-ai": "^0.24.1",
        "@napi-rs/canvas": "^1.0.9",
        "adm-zip": "^0.6.1",
        "axios": "^1.20.0",
        "better-sqlite3": "13.0.3",
        "cheerio": "^1.1.2",
        "cookie-parser": "^1.4.7",
        "eventsource": "^5.1.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.2.1",
        "gpt-tokenizer": "^4.0.0",
        "highlight.js": "^11.12.0",
        "http-proxy-agent": "^9.1.0",
        "https-proxy-agent": "^9.1.0",
        "ioredis": "^6.0.0",
        "jsonwebtoken": "^9.0.2",
        "marked": "^18.0.1",
        "markmap-lib": "^0.18.12",
        "mathjax-full": "^3.2.2",
        "multer": "^2.0.2",
        "node-fetch": "^3.3.2",
        "openai": "^6.42.0",
        "puppeteer-extra": "^3.3.6",
        "puppeteer-extra-plugin-stealth": "^2.11.2",
        "qrcode": "^1.5.4",
        "sharp": "^0.34.5",
        "socks-proxy-agent": "^10.1.0",
        "tesseract.js": "^6.0.1",
        "turndown": "^7.2.2",
        "uuid": "^11.0.3",
        "vectra": "^0.15.0",
        "ws": "^8.18.3",
        "yaml": "^2.6.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "acorn": "8.18.0",
        "eslint": "^9.39.2",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "prettier": "^3.6.2",
        "typescript-eslint": "^8.70.0"
    }
